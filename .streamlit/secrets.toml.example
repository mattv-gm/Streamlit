# Copy this file to .streamlit/secrets.toml and fill in your credentials.
# Do NOT commit secrets.toml to version control.

[snowflake]
account   = "your_account_identifier"   # e.g. "abc12345.us-east-1"
user      = "your_username"
password  = "your_password"             # or use private_key_path below
warehouse = "your_warehouse"            # optional, used for overhead queries
database  = "SNOWFLAKE"
schema    = "ACCOUNT_USAGE"
role      = "ACCOUNTADMIN"              # must have ACCOUNT_USAGE grants

# ── Private key authentication (alternative to password) ─────────────────────
# private_key_path = "/path/to/private_key.p8"
